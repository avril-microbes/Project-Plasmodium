scale_color_viridis_c(option = "A", limits = c(3, 21)) +
labs(color = "Days post-infection")  +
scale_y_continuous(labels = function(x) format(x, scientific = TRUE)) +
scale_x_continuous(labels = label_scientific(digits = 1))
}
)
